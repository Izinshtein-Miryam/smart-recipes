# Copy to backend/.env and fill in. Never commit the real .env file.
DATABASE_URL=sqlite:///./smart_recipes.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
MEDIA_DIR=./media

# AI providers: "mock" for development/tests, "openai" for the real provider.
# One OpenAI key serves text, images and (optionally) embeddings.
OPENAI_API_KEY=

LLM_PROVIDER=mock
OPENAI_MODEL=gpt-5-mini
AI_TIMEOUT_SECONDS=30

IMAGE_PROVIDER=mock
OPENAI_IMAGE_MODEL=gpt-image-1
IMAGE_TIMEOUT_SECONDS=120

# "mock", "sentence" (local model, needs the `embeddings` extra) or "openai"
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
