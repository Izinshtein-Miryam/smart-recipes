# Copy to backend/.env and fill in. Never commit the real .env file.
DATABASE_URL=postgresql+psycopg://recipes:recipes@localhost:5432/recipes
CORS_ORIGINS=["http://localhost:5173"]
STORAGE_DIR=./storage

# OpenAI (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Single admin. Generate the hash with: python -m app.cli hash-admin-password
# Keep the single quotes - the hash contains "$" characters.
ADMIN_PASSWORD_HASH=''
JWT_SECRET=change-me-to-a-long-random-string
