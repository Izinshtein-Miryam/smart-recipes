# Docker Compose settings. Copy to .env (never commit it) and fill in.
# Use a strong password in production. For local dev (./dev.sh) keep it equal to the one in backend/.env.example.
POSTGRES_PASSWORD=recipes

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Generate with: docker compose run --rm backend python -m app.cli hash-admin-password
# Keep the single quotes - the hash contains "$" characters.
ADMIN_PASSWORD_HASH=''
JWT_SECRET=change-me-to-a-long-random-string

# Public origin of the site, for CORS
CORS_ORIGINS=["http://localhost:8080"]
